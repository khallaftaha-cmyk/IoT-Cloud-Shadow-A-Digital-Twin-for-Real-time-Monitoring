{
  "id": null,
  "uid": "digital-twin-001",
  "title": "Digital Twin — Multi-Sensor & Actuation Monitor",
  "tags": ["iot", "digital-twin"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Temperature over time",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRESQL}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "celsius"
        }
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT timestamp AS time, temperature, device_id FROM \"Sensor_Data\" WHERE $__timeFilter(timestamp) ORDER BY timestamp ASC",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Humidity & Pressure",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRESQL}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT timestamp AS time, humidity FROM \"Sensor_Data\" WHERE $__timeFilter(timestamp) AND humidity IS NOT NULL ORDER BY timestamp ASC",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Latest Temperature",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 6 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRESQL}" },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 0,
          "max": 50,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 25 },
              { "color": "red", "value": 30 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT NOW() AS time, temperature FROM \"Sensor_Data\" ORDER BY timestamp DESC LIMIT 1",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Battery Level",
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 6 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRESQL}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 20 },
              { "color": "green", "value": 50 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT NOW() AS time, COALESCE(battery_level, 100) AS battery FROM \"Sensor_Data\" ORDER BY timestamp DESC LIMIT 1",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Recent Triggered Alerts",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 6 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRESQL}" },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT id, device_id, metric, value, severity, message, triggered_at FROM alerts ORDER BY triggered_at DESC LIMIT 10",
          "format": "table"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Actuation Commands Log",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 6 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRESQL}" },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT id, device_id, command, status, issued_at, acknowledged_at FROM actuator_commands ORDER BY issued_at DESC LIMIT 10",
          "format": "table"
        }
      ]
    }
  ],
  "__inputs": [
    { "name": "DS_POSTGRESQL", "label": "PostgreSQL", "type": "datasource", "pluginId": "postgres" }
  ],
  "__requires": [
    { "type": "datasource", "id": "postgres", "name": "PostgreSQL", "version": "1.0.0" }
  ]
}