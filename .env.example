# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
# For local development use 'db' (the Docker Compose service name)
# For AWS deployment use your RDS endpoint
DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_db_password_here
DATABASE_NAME=fastapi

# ── JWT Authentication ─────────────────────────────────────────────────────────
# Generate a secure key with: openssl rand -hex 32
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Anthropic LLM (Optional) ───────────────────────────────────────────────────
# Leave empty — the core API and digital twin work without it.
# Only required if you enable the AI anomaly monitor feature.
ANTHROPIC_API_KEY=

# ── Grafana ────────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=your_grafana_password_here

# ── Redis (Twin State Cache) ───────────────────────────────────────────────────
# Use 'redis' (Docker Compose service name) for containerized deployment
REDIS_URL=redis://redis:6379/0

# ── MQTT Broker ────────────────────────────────────────────────────────────────
# Option A: Local Mosquitto broker (default for development)
MQTT_BROKER_HOST=mqtt
MQTT_BROKER_PORT=1883

# Option B: AWS IoT Core (production) — uncomment these and comment out above
# MQTT_BROKER_HOST=your-endpoint-ats.iot.eu-north-1.amazonaws.com
# MQTT_BROKER_PORT=8883
# Note: also place your X.509 certificates in the certs/ directory
